      <svg viewBox="0 0 600 100" preserveAspectRatio="none"><path d="M0,58 C35,30 70,30 105,58 S175,86 210,58 S280,30 315,58 S385,86 420,58 S490,30 525,58 S595,86 600,58" stroke="#37A17C" stroke-width="2" fill="none" opacity=".85"/></svg>
    </div>
