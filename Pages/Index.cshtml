@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Vibrant Kochos — Reflexology, Coaching, Vitamins &amp; Frequency Healing</title>
<meta name="description" content="Whole-person wellness: reflexology, coaching, vitamins and frequency healing with Vibrant Kochos." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@@0,9..144,500;0,9..144,650;1,9..144,600&family=DM+Sans:wght@@400;500;600&display=swap" rel="stylesheet" />
<style>
:root{
  --teal:#0C2B2A;
  --teal-soft:#123B39;
  --gold:#E7B24C;
  --jade:#37A17C;
  --paper:#F5EFE3;
  --paper-dim:rgba(245,239,227,.72);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--teal);
  color:var(--paper);
  font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
h1,h2{font-family:"Fraunces",Georgia,serif;font-weight:650;line-height:1.1}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:4px}
.wrap{max-width:1060px;margin:0 auto;padding:0 1.4rem}

/* ---------- Hero ---------- */
.hero{
  position:relative;
  min-height:88vh;
  display:flex;
  align-items:center;
  overflow:hidden;
  background:
    radial-gradient(60rem 32rem at 80% -12%, rgba(55,161,124,.20), transparent 60%),
    radial-gradient(46rem 26rem at 8% 108%, rgba(231,178,76,.10), transparent 60%),
    var(--teal);
  text-align:center;
}
.hero .wrap{position:relative;z-index:2;padding-top:5.5rem;padding-bottom:9rem;width:100%}
.eyebrow{
  display:inline-block;
  font-size:.8rem;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--gold);
  border:1px solid rgba(231,178,76,.45);
  border-radius:999px;
  padding:.45rem 1.1rem;
  margin-bottom:1.6rem;
}
.hero h1{
  font-size:clamp(2.9rem,8vw,5.4rem);
  letter-spacing:-.01em;
  margin-bottom:1rem;
}
.hero h1 em{font-style:italic;font-weight:600;color:var(--gold)}
.tagline{
  max-width:34rem;
  margin:0 auto 2.2rem;
  font-size:clamp(1.05rem,2.4vw,1.25rem);
  color:var(--paper-dim);
}
.btn{
  display:inline-block;
  background:var(--gold);
  color:var(--teal);
  font-weight:600;
  font-size:1.05rem;
  text-decoration:none;
  padding:.95rem 2.2rem;
  border-radius:999px;
  box-shadow:0 6px 24px rgba(231,178,76,.30);
  transition:transform .18s ease, box-shadow .18s ease;
}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(231,178,76,.42)}

/* ---------- Resonance wave ---------- */
.waves{
  position:absolute;
  inset:auto 0 0 0;
  height:9.5rem;
  z-index:1;
  pointer-events:none;
  overflow:hidden;
}
.wave-track{
  position:absolute;
  bottom:0;
  left:0;
  width:200%;
  height:100%;
  display:flex;
  animation:drift 26s linear infinite;
}
.wave-track.slow{animation-duration:44s;opacity:.5;bottom:.9rem}
.wave-track.slower{animation-duration:70s;opacity:.25;bottom:1.9rem}
.wave-track svg{width:50%;height:100%;flex:none}
@@keyframes drift{
  from{transform:translateX(0)}
  to{transform:translateX(-50%)}
}

/* ---------- Sections ---------- */
section{padding:5rem 0}
.intro{text-align:center;background:var(--teal-soft)}
.intro p{
  font-family:"Fraunces",Georgia,serif;
  font-size:clamp(1.3rem,3vw,1.7rem);
  font-style:italic;
  max-width:42rem;
  margin:0 auto;
  color:var(--paper);
}
.section-head{text-align:center;margin-bottom:3rem}
.section-head h2{font-size:clamp(1.9rem,4.5vw,2.6rem);margin-bottom:.6rem}
.section-head p{color:var(--paper-dim);max-width:32rem;margin:0 auto}

/* ---------- Services ---------- */
.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:1.2rem;
}
.card{
  background:var(--teal-soft);
  border:1px solid rgba(245,239,227,.10);
  border-radius:1.1rem;
  padding:1.8rem 1.5rem;
  transition:transform .18s ease, border-color .18s ease;
}
.card:hover{transform:translateY(-4px);border-color:rgba(231,178,76,.45)}
.card svg{width:2.4rem;height:2.4rem;stroke:var(--jade);stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round;margin-bottom:1rem}
.card h3{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.25rem;margin-bottom:.5rem;color:var(--gold)}
.card p{font-size:.97rem;color:var(--paper-dim)}

/* ---------- Contact ---------- */
.contact{background:var(--teal-soft);text-align:center}
.contact-btns{display:flex;flex-wrap:wrap;justify-content:center;gap:.9rem;margin-top:2rem}
.cbtn{
  display:inline-flex;
  align-items:center;
  gap:.55rem;
  border:1.5px solid rgba(231,178,76,.55);
  color:var(--paper);
  text-decoration:none;
  font-weight:500;
  padding:.8rem 1.6rem;
  border-radius:999px;
  transition:background .18s ease,color .18s ease;
}
.cbtn:hover{background:var(--gold);color:var(--teal)}
.cbtn svg{width:1.15rem;height:1.15rem;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}

/* ---------- Footer ---------- */
footer{
  text-align:center;
  padding:2.4rem 1rem;
  border-top:1px solid rgba(245,239,227,.10);
  color:var(--paper-dim);
  font-size:.9rem;
}
footer strong{font-family:"Fraunces",Georgia,serif;font-weight:600;color:var(--paper)}

@@media (max-width:600px){
  section{padding:3.5rem 0}
  .hero .wrap{padding-top:4rem;padding-bottom:8rem}
}
@@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .wave-track{animation:none}
  .btn,.card,.cbtn{transition:none}
}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <p class="eyebrow">Reflexology &middot; Coaching &middot; Vitamins &middot; Frequency Healing</p>
    <h1>Vibrant <em>Kochos</em></h1>
    <p class="tagline">Restoring balance from the ground up — gentle, natural therapies that help your body find its own rhythm again.</p>
    <a class="btn" href="#contact">Book a session</a>
  </div>
  <div class="waves" aria-hidden="true">
    <div class="wave-track slower">
      <svg viewBox="0 0 600 100" preserveAspectRatio="none"><path d="M0,60 C40,20 80,20 120,60 S200,100 240,60 S320,20 360,60 S440,100 480,60 S560,20 600,60" stroke="#37A17C" stroke-width="1.6" fill="none"/></svg>
      <svg viewBox="0 0 600 100" preserveAspectRatio="none"><path d="M0,60 C40,20 80,20 120,60 S200,100 240,60 S320,20 360,60 S440,100 480,60 S560,20 600,60" stroke="#37A17C" stroke-width="1.6" fill="none"/></svg>
    </div>
    <div class="wave-track slow">
      <svg viewBox="0 0 600 100" preserveAspectRatio="none"><path d="M0,55 C50,95 100,95 150,55 S250,15 300,55 S400,95 450,55 S550,15 600,55" stroke="#E7B24C" stroke-width="1.6" fill="none"/></svg>
      <svg viewBox="0 0 600 100" preserveAspectRatio="none"><path d="M0,55 C50,95 100,95 150,55 S250,15 300,55 S400,95 450,55 S550,15 600,55" stroke="#E7B24C" stroke-width="1.6" fill="none"/></svg>
    </div>
    <div class="wave-track">
